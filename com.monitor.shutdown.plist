<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.monitor.shutdown</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/dev345/code/kfirfer/monitor-mac/shutdown-hook.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ExitTimeOut</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/tmp/shutdown-hook-agent.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/shutdown-hook-agent.err</string>
</dict>
</plist>
