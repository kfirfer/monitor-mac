          },
          "rawSql": "WITH active_procs AS (\n  SELECT name\n  FROM \"host.process_cpu_usage\"\n  WHERE $__timeFilter(time)\n  GROUP BY name\n  HAVING COUNT(*) > 1 AND MAX(value) - MIN(value) > 0.001\n)\nSELECT p.name, p.value\nFROM \"host.process_cpu_usage\" p\nINNER JOIN active_procs ap ON p.name = ap.name\nWHERE $__timeFilter(p.time)\n  AND p.time = (SELECT MAX(time) FROM \"host.process_cpu_usage\" WHERE $__timeFilter(time))\nORDER BY p.value DESC\nLIMIT 500",
          "refId": "A",
          "format": "table"
        }
