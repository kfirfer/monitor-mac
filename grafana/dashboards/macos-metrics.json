        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-macos"
          },
          "rawSql": "WITH rx_rates AS (\n  SELECT time, device,\n    GREATEST((value - LAG(value) OVER (PARTITION BY device ORDER BY time))\n    / EXTRACT(EPOCH FROM (time - LAG(time) OVER (PARTITION BY device ORDER BY time))), 0.0) AS rate\n  FROM \"host.network_receive_bytes_total\"\n  WHERE $__timeFilter(time)\n),\ntx_rates AS (\n  SELECT time, device,\n    GREATEST((value - LAG(value) OVER (PARTITION BY device ORDER BY time))\n    / EXTRACT(EPOCH FROM (time - LAG(time) OVER (PARTITION BY device ORDER BY time))), 0.0) AS rate\n  FROM \"host.network_transmit_bytes_total\"\n  WHERE $__timeFilter(time)\n)\nSELECT date_bin($__interval, time) AS time, CONCAT(device, ' rx') AS metric, AVG(rate) AS value\nFROM rx_rates WHERE rate IS NOT NULL\nGROUP BY date_bin($__interval, time), device\nUNION ALL\nSELECT date_bin($__interval, time) AS time, CONCAT(device, ' tx') AS metric, AVG(rate) AS value\nFROM tx_rates WHERE rate IS NOT NULL\nGROUP BY date_bin($__interval, time), device\nORDER BY time",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "title": "Network Traffic",
      "type": "timeseries",
