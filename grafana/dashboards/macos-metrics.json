        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-macos"
          },
          "rawSql": "WITH pcts AS (\n  SELECT time, mode,\n    value / EXTRACT(EPOCH FROM (time - LAG(time) OVER (PARTITION BY cpu, mode ORDER BY time))) * 100.0 AS pct\n  FROM \"host.cpu_seconds_total\"\n  WHERE $__timeFilter(time)\n    AND mode IN ('user', 'system', 'idle')\n)\nSELECT\n  date_bin($__interval, time) AS time,\n  mode,\n  AVG(pct) AS value\nFROM pcts\nWHERE pct IS NOT NULL\nGROUP BY date_bin($__interval, time), mode\nORDER BY time",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "title": "CPU Usage",
      "type": "timeseries",
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^value (.+)$",
            "renamePattern": "$1"
          }
        }
      ]
    },
