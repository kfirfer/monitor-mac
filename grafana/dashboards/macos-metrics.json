          },
          "rawSql": "SELECT\n  t.time,\n  (a.value / t.value) * 100.0 AS value,\n  'used' AS metric\nFROM \"host.memory_total_bytes\" t\nINNER JOIN \"host.memory_active_bytes\" a ON t.time = a.time\nWHERE $__timeFilter(t.time)\nORDER BY t.time",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "title": "Memory Usage",
      "type": "timeseries"
