            "uid": "influxdb-macos"
          },
          "rawSql": "SELECT\n  date_bin($__interval, time) AS time,\n  CONCAT(device, ' - ', filesystem, ' - ', mountpoint) AS metric,\n  AVG(value * 100.0) AS value\nFROM \"host.filesystem_used_ratio\"\nWHERE\n  $__timeFilter(time)\n  AND mountpoint != '/dev'\nGROUP BY date_bin($__interval, time), device, filesystem, mountpoint\nORDER BY time",
